<Project>
  <!--
    빌드 결과물(bin/obj)을 저장소 루트의 .artifacts/ 로 모은다.
    이 저장소는 Unity 프로젝트의 Assets 폴더 안에 submodule 로 들어가므로,
    bin/obj 가 소스 옆에 생기면 Unity 가 DLL 을 플러그인으로 가져가 충돌한다.
    '.' 으로 시작하는 폴더는 Unity 가 무시한다.
  -->
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory).artifacts</ArtifactsPath>
  </PropertyGroup>
</Project>
